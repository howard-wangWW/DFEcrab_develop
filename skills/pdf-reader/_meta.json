{
  "name": "pdf-reader",
  "version": "1.0.0",
  "description": "读取 PDF 文件，提取文本内容",
  "author": "DFEcrab Team",
  "tags": ["pdf", "reader", "text", "extract"],
  "parameters": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string",
        "description": "PDF 文件路径"
      },
      "pages": {
        "type": "array",
        "items": {"type": "integer"},
        "description": "指定页码列表（从 1 开始）"
      },
      "start_page": {
        "type": "integer",
        "description": "起始页码"
      },
      "end_page": {
        "type": "integer",
        "description": "结束页码"
      },
      "extract_images": {
        "type": "boolean",
        "description": "是否提取图片",
        "default": false
      },
      "output_dir": {
        "type": "string",
        "description": "图片输出目录"
      }
    },
    "required": ["file_path"]
  }
}
