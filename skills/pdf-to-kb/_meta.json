{
  "name": "pdf-to-kb",
  "version": "1.0.0",
  "description": "将 PDF 文档保存为知识库",
  "author": "DFEcrab Team",
  "tags": ["pdf", "knowledge", "memory", "knowledge-base"],
  "parameters": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string",
        "description": "PDF 文件路径"
      },
      "title": {
        "type": "string",
        "description": "文档标题"
      },
      "agent_id": {
        "type": "string",
        "description": "目标智能体 ID（默认保存到共享记忆）"
      },
      "memory_type": {
        "type": "string",
        "enum": ["daily", "long_term"],
        "description": "记忆类型",
        "default": "long_term"
      },
      "pages": {
        "type": "array",
        "items": {"type": "integer"},
        "description": "指定页码"
      },
      "summarize": {
        "type": "boolean",
        "description": "是否生成摘要",
        "default": true
      }
    },
    "required": ["file_path"]
  }
}
