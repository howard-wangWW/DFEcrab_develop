@cli.command()
def start_mcp():
    """单独启动所有本地 MCP 服务（demo / alert_judge_tools / blackxml_topology 等）"""
    import time
    import os

    venv_python = _resolve_venv_python()

    env = os.environ.copy()
    env["PYTHONPATH"] = env.get("PYTHONPATH", "") + f":{project_root}:{project_root}/src"

    def _port_listening(port: int, host: str = "127.0.0.1") -> bool:
        import socket
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            return s.connect_ex((host, port)) == 0
        finally:
            s.close()

    click.echo("🔌 检测本地 MCP 服务...")
    mcp_cfg_path = project_root / "config" / "mcporter.json"
    if not mcp_cfg_path.exists():
        click.echo("   未找到 config/mcporter.json，跳过 MCP 启动")
        return

    try:
        mcp_cfg = json.loads(mcp_cfg_path.read_text(encoding="utf-8"))
        mcp_servers = mcp_cfg.get("mcpServers", {})
        logs_dir = project_root / "logs" / "mcp"
        logs_dir.mkdir(parents=True, exist_ok=True)
        from config.port_loader import load_local_ports
        yaml_mcp_ports = (load_local_ports().get("mcp") or {})
        mcp_dir = project_root / "mcp_servers"
        started_any = False

        for svc_name, svc_conf in mcp_servers.items():
            if svc_conf.get("enabled", True) is False:
                continue
            base_url = svc_conf.get("baseUrl", "")
            if not base_url.startswith(("http://127.0.0.1", "http://localhost")):
                continue
            from urllib.parse import urlparse
            parsed = urlparse(base_url)
            base_port = parsed.port or (443 if parsed.scheme == "https" else 80)
            host = parsed.hostname or "127.0.0.1"
            yaml_port = yaml_mcp_ports.get(svc_name)
            if yaml_port is not None and yaml_port != base_port:
                click.echo(click.style(
                    f"   ⚠️ MCP[{svc_name}] 端口不一致: gateway.yaml={yaml_port} vs mcporter.json={base_port}，"
                    f"请先对齐 config/gateway.yaml 的 local_ports.mcp.{svc_name}", fg='yellow'))
            port = yaml_port if yaml_port is not None else base_port

            if _port_listening(port, host):
                click.echo(f"   ✅ MCP[{svc_name}] 已在运行 (端口 {port})")
                continue

            svc_script = None
            alias_file = _MCP_SCRIPT_ALIASES.get(svc_name)
            for cand in [alias_file, f"{svc_name}.py", f"mcp_{svc_name}.py"]:
                if not cand:
                    continue
                p = mcp_dir / cand
                if p.exists():
                    svc_script = p
                    break
            if svc_script is None:
                click.echo(click.style(
                    f"   ⚠️ MCP[{svc_name}] 脚本缺失: 未找到 {svc_name} 对应脚本", fg='yellow'))
                continue

            click.echo(f"   🔧 启动 MCP[{svc_name}] (端口 {port})...")
            mcp_env = dict(env)
            mcp_env.pop("PYTHONPATH", None)
            mcp_env["MCP_PORT"] = str(port)
            log_file = logs_dir / f"mcp_{svc_name}.log"
            with open(log_file, "a", encoding="utf-8") as lf:
                subprocess.Popen(
                    [str(venv_python), str(svc_script)],
                    stdout=lf, stderr=lf,
                    env=mcp_env, start_new_session=True,
                )
            started_any = True

        if started_any:
            click.echo("   二次检测本地 MCP 端口（轮询等待，最长 15 秒）...")
            for svc_name, svc_conf in mcp_servers.items():
                if svc_conf.get("enabled", True) is False:
                    continue
                base_url = svc_conf.get("baseUrl", "")
                if not base_url.startswith(("http://127.0.0.1", "http://localhost")):
                    continue
                from urllib.parse import urlparse
                parsed = urlparse(base_url)
                base_port = parsed.port or (443 if parsed.scheme == "https" else 80)
                host = parsed.hostname or "127.0.0.1"
                yaml_port = yaml_mcp_ports.get(svc_name)
                port = yaml_port if yaml_port is not None else base_port
                # ★ 轮询等待端口就绪（MCP 冷启动较慢，固定 sleep 会误报失败）
                if _wait_port_listening(port, host, timeout=15):
                    click.echo(f"   ✅ MCP[{svc_name}] 启动成功 (端口 {port})")
                else:
                    click.echo(click.style(
                        f"   ⚠️ MCP[{svc_name}] 端口未监听，启动可能失败，日志: logs/mcp/mcp_{svc_name}.log",
                        fg='yellow'))
    except Exception as e:
        click.echo(click.style(
            f"   ⚠️ 本地 MCP 检测异常: {e}", fg='yellow'))


