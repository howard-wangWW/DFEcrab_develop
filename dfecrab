def _kill_processes_by_cmdline(patterns, label):
    """按命令行匹配停止进程（三轮 SIGTERM -> SIGKILL）。

    patterns: list[str]，匹配进程 cmdline 子串（如 "mcp_servers/mcp_demo.py"）。
    与 stop() 逻辑一致，供 stop_mcp / stop_knowledge 复用，避免重复代码。
    """
    import signal
    import os
    import time

    def get_pids():
        pids = set()
        try:
            import psutil
            for proc in psutil.process_iter(['pid', 'name', 'cmdline']):
                try:
                    cmdline = ' '.join(proc.info.get('cmdline') or [])
                    if any(p in cmdline for p in patterns):
                        pids.add(proc.info['pid'])
                except (psutil.NoSuchProcess, psutil.AccessDenied):
                    pass
        except ImportError:
            for pat in patterns:
                result = subprocess.run(
                    ["pgrep", "-f", pat], capture_output=True, text=True
                )
                if result.returncode == 0:
                    for pid in result.stdout.strip().split('\n'):
                        if pid.strip():
                            pids.add(int(pid.strip()))
        return pids

    click.echo(f"🛑 正在停止{label}相关进程...")
    for round_num in range(3):
        pids = get_pids()
        if not pids:
            break
        sig = signal.SIGTERM if round_num == 0 else signal.SIGKILL
        sig_name = "SIGTERM" if round_num == 0 else "SIGKILL"
        for pid in pids:
            try:
                os.kill(pid, sig)
                click.echo(f"  第{round_num + 1}轮({sig_name}): 已停止 PID {pid}")
            except ProcessLookupError:
                pass
            except PermissionError:
                click.echo(f"  ⚠️  无权限停止 PID {pid}")
            except Exception as e:
                click.echo(f"  ⚠️  停止 PID {pid} 失败: {e}")
        time.sleep(1)

    remaining = get_pids()
    if remaining:
        click.echo(f"⚠️  警告：仍有 {len(remaining)} 个进程残留: {sorted(remaining)}")
        click.echo("   请手动执行: pkill -9 -f <进程名>")
    else:
        click.echo(f"✅ {label}相关进程已清理完毕")


