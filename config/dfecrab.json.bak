  "context_engine": {
    "auto_compact_threshold": 0.85,
    "compact_keep_recent": 2
  },
  "react": {
    "max_tool_result_chars": 12000,
    "context_msg_limit": 16,
    "deferred_tools": false,
    "deferred_keep": 15
  },
  "mcp": {
    "max_tools_per_agent": 30
  }
